# Server
PORT=3000
NODE_ENV=development

# JWT — change in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins (Vite web dashboard + Expo dev, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006,http://127.0.0.1:5173,http://127.0.0.1:8081

# PostgreSQL (pgAdmin) — encode special chars in password (@ → %40)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/advisor_track

# live | demo — demo never starts against advisor_track / production credentials
ADVISORTRACK_MODE=live

# POPIA — AES-256-GCM encryption for contact email/phone/notes at rest
# Generate: node scripts/generate-pii-key.js
PII_ENCRYPTION_KEY=
POPIA_NOTICE_VERSION=2026-06

# Transactional email (Mailtrap Email Sending — send.api.mailtrap.io)
# Create token: Mailtrap → Sending Domains → API Tokens
MAILTRAP_API_TOKEN=
MAIL_FROM_EMAIL=hello@advisortrack.co.za
MAIL_FROM_NAME=AdvisorTrack

# Links in verification / password-reset emails (must match app.json "scheme")
APP_DEEP_LINK_SCHEME=advisortrack

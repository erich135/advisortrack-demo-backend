# Demo runtime only. Copy to .env.demo and fill secrets locally/on the demo host.
# Never point this file at advisor_track or production credentials.

ADVISORTRACK_MODE=demo
NODE_ENV=production
PORT=3001

JWT_SECRET=replace-with-a-long-random-demo-only-secret
JWT_EXPIRES_IN=12h

CORS_ORIGINS=https://demo.advisortrack.co.za

# AWS demo uses advisortrack_demo. Local development uses advisortrack_demo_dev.
DATABASE_URL=postgresql://advisortrack_demo:replace-me@127.0.0.1:5432/advisortrack_demo

PII_ENCRYPTION_KEY=
POPIA_NOTICE_VERSION=2026-06

# Must remain empty in the public demo.
MAILTRAP_API_TOKEN=

# Public demo session lifetime. Role switching does not extend this.
DEMO_SESSION_TTL_MINUTES=120
DEMO_EXPIRY_SWEEP_MINUTES=15

MAIL_FROM_EMAIL=hello@advisortrack.co.za
MAIL_FROM_NAME=AdvisorTrack
APP_DEEP_LINK_SCHEME=advisortrack
